{
  "name": "grounding-lite-sample-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --force\" \"npm run dev:server:watch\"",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.server.json",
    "lint": "eslint . --ext .js,.ts",
    "dev:server": "npm run dev:server:watch",
    "dev:server:watch": "nodemon --watch start.ts --watch mcpPlacesServer.ts --watch types.ts --watch api/ --watch services/ --exec \"node --import 'data:text/javascript,import { register } from \\\"node:module\\\"; import { pathToFileURL } from \\\"node:url\\\"; register(\\\"ts-node/esm\\\", pathToFileURL(\\\"./\\\"));' start.ts\"",
    "preview": "vite preview",
    "start": "npm run start:prod",
    "start:prod": "node dist/start.js"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "@google/genai": "1.29.0",
    "@modelcontextprotocol/sdk": "1.24.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lit": "^3.1.3",
    "marked": "^13.0.3",
    "zod": "~3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/cheerio": "^1.0.0",
    "@types/express": "^5.0.5",
    "@types/marked": "^4.3.2",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-lit": "^2.1.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
